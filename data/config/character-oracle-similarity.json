 "oracles": [
  {
   "oracle_id": "O01",
   "text": "汝将最后一次沐浴，在温热耀眼的黄金中。",
   "holder": "阿格莱雅"
  },
  {
   "oracle_id": "O02",
   "text": "汝将碎作千片，凋零在他乡的土壤。",
   "holder": "缇宝"
  },
  {
   "oracle_id": "O03",
   "text": "终有一日，汝将背后负创而死。",
   "holder": "万敌"
  },
  {
   "oracle_id": "O04",
   "text": "花海尽头，生者的魂灵将温暖汝之指尖；相拥之后，便是永恒的离别。",
   "holder": "遐蝶"
  },
  {
   "oracle_id": "O05",
   "text": "汝将凋零，令逝者自残余中发芽，一同死去的火新生。",
   "holder": "玻吕茜亚"
  },
  {
   "oracle_id": "O06",
   "text": "汝将超越至纯粹之终极，回归腐败苦黑。",
   "holder": "那刻夏"
  },
  {
   "oracle_id": "O07",
   "text": "在彩虹桥的尽头，天空之子将缝补晨昏。",
   "holder": "风堇"
  },
  {
   "oracle_id": "O08",
   "text": "汝将与贪婪同行，亦将亡于分文。",
   "holder": "赛飞儿"
  },
  {
   "oracle_id": "O09",
   "text": "汝将肩负骄阳，直至灰白的黎明显著。",
   "holder": "白厄"
  },
  {
   "oracle_id": "O10",
   "text": "汝将长眠于涛声中，于天地境界之海完成征服。",
   "holder": "海瑟音"
  },
  {
   "oracle_id": "O11",
   "text": "汝将于天地境界之海完成征服，长眠于涛声中。",
   "holder": "刻律德菈"
  },
  {
   "oracle_id": "O12",
   "text": "汝将自掘坟墓，焚毁于叛逆的熔炉。",
   "holder": "荒笛"
  },
  {
   "oracle_id": "O13",
   "text": "汝将收梢于花开时，一如终结诞下起始。",
   "holder": "昔涟"
  }
 ],
