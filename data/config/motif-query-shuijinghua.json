{
  "query": "水晶花",
  "n_occurrences": 11,
  "by_version": {
    "3.7": 11
  },
  "occurrences": [
    {
      "record_id": 23888,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "从前，有一朵「无瑕」的水晶花，闪闪发光。像桃子的每一篇故事。"
    },
    {
      "record_id": 23890,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "可它看呀看，却发现水晶花天衣无缝，兜兜转转，只看见自己的倒影。"
    },
    {
      "record_id": 23891,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "既然如此，就努力学习吧！于是小妖精每天过来，守在水晶花旁，思考答案。"
    },
    {
      "record_id": 23892,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "直到有一天，它惊讶地发现——水晶花掉在地上，碎掉了！"
    },
    {
      "record_id": 23903,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "然后它就会明白，原来「无瑕」的水晶花，既没有「心」，也不懂「爱」。"
    },
    {
      "record_id": 23906,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "水晶花之所以纯粹，是因为它封闭了自己，孤独绽放。才会在有缺的世界中格外耀眼。"
    },
    {
      "record_id": 23910,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "「水晶花掉在地上，碎掉了。」"
    },
    {
      "record_id": 23913,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "而在它眼里，不再「无瑕」的水晶花，终于有了「心」，也学会了「爱」。"
    },
    {
      "record_id": 23953,
      "version": "3.7",
      "task": "魔女的孤诣课题",
      "speaker": "昔涟",
      "text": "是呀。所以我相信，这一切都是真实的。就像水晶花跌落的瞬间……"
    },
    {
      "record_id": 25226,
      "version": "3.7",
      "task": "纸页啊，镌留记忆的涟漪",
      "speaker": "昔涟",
      "text": "那你一定还记得，水晶花和小妖精，我为你写下的第一首诗。"
    },
    {
      "record_id": 26165,
      "version": "3.7",
      "task": "落英啊，残芳纷飞留归躅",
      "speaker": "昔涟",
      "text": "「还记得我最喜欢的故事吗？水晶花之所以美丽，是因为它映出了小妖精的眼睛。」"
    }
  ],
